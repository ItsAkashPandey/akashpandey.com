# Copy to .env.local for local work; set the same keys in Vercel for production.
# Everything is optional: the pages all work with none of these set.

# --- Kasi (chat) ---
# Set any of these; all have free tiers. Kasi asks the first one that has a
# key and moves on to the next when it is rate limited or down.
# Cerebras (fastest, cloud.cerebras.ai)
CEREBRAS_API_KEY=
# Groq (fast, but the free tier only fits about one question a minute)
GROQ_API_KEY=
# Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
# OpenRouter (free models, plus openrouter/free as a last resort)
OPENROUTER_API_KEY=
# Optional: order to try them in, and the model(s) for each (comma-separated)
KASI_PROVIDERS=cerebras,groq,gemini,openrouter
CEREBRAS_MODEL=
GROQ_MODEL=
GEMINI_MODEL=
# OpenRouter: first choice and backups. A paid model gives
# noticeably better answers than the free ones.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
# Anything Kasi should know but that shouldn't sit in the public repo
KASI_PRIVATE_NOTES=
# Optional. Signs Kasi's replies so the chat history can't be edited; falls
# back to ADMIN_SESSION_SECRET, then one of the model keys
CHAT_SIGNING_SECRET=

# --- Contact form (Resend) ---
RESEND_API_KEY=
# Needs a domain verified in Resend. Without it mail goes out from
# onboarding@resend.dev, which only reaches the Resend account owner.
CONTACT_FROM_EMAIL="Akash Pandey <contact@akashpandey.com>"
CONTACT_TO_EMAIL=akash_k@ce.iitr.ac.in
# Cloudflare Turnstile spam check, optional (both or neither)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limits shared across serverless instances (optional) ---
# Vercel's Upstash/KV integration sets these for you
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Chat logs (see docs/chat-logging.md) ---
# Postgres (recommended). POSTGRES_URL from Vercel/Neon works too.
CHAT_LOG_DATABASE_URL=
# Or a Google Sheet through Apps Script
CHAT_LOG_WEBHOOK_URL=
CHAT_LOG_WEBHOOK_TOKEN=
# Local development only
CHAT_LOG_FILE_PATH=./logs/chat-log.jsonl
# Days to keep logs, 0 = forever (default 180)
CHAT_LOG_RETENTION_DAYS=180

# --- Admin page (/admin) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=
# Bump to sign every admin session out
ADMIN_SESSION_VERSION=1
